{
  "schemaVersion": 1,
  "scenes": [
    {
      "id": "introduction",
      "image": "doctor.jpg",
      "alt": {
        "ja": "黒い背景の前にいる白衣の博士",
        "en": "The doctor in a lab coat against a dark background",
        "fr": "Le docteur en blouse devant un fond sombre"
      },
      "eyebrow": {
        "ja": "観測調査",
        "en": "OBSERVATION SURVEY",
        "fr": "MISSION D’OBSERVATION"
      },
      "title": {
        "ja": "調査依頼",
        "en": "Survey briefing",
        "fr": "Présentation de la mission"
      },
      "caption": {
        "ja": "博士 · 観測調査担当",
        "en": "Doctor · Observation research",
        "fr": "Docteur · Recherche sur les phénomènes"
      },
      "cues": {
        "ja": [
          {
            "text": "私はこの研究所で怪異の観測を担当しています。",
            "durationMs": 3500
          },
          {
            "text": "怪異が報告された壁を、あなたに調査員として調べていただきたい。",
            "durationMs": 4500
          }
        ],
        "en": [
          {
            "text": "I study anomalous phenomena here at the institute.",
            "durationMs": 3400
          },
          {
            "text": "I would like you to investigate a wall where anomalies have been reported.",
            "durationMs": 4800
          }
        ],
        "fr": [
          {
            "text": "J’étudie les phénomènes anormaux dans cet institut.",
            "durationMs": 3500
          },
          {
            "text": "Je vous confie une enquête sur un mur autour duquel des anomalies ont été signalées.",
            "durationMs": 5500
          }
        ]
      }
    },
    {
      "id": "subject",
      "image": "briefing-wall-v1.png",
      "alt": {
        "ja": "暗い調査室に保管されたL字の壁面",
        "en": "A recovered L-shaped wall held in a dark examination room",
        "fr": "Un mur récupéré en forme de L dans une salle d’examen sombre"
      },
      "eyebrow": {
        "ja": "調査方法",
        "en": "SURVEY PROCEDURE",
        "fr": "DÉROULEMENT"
      },
      "title": {
        "ja": "回収壁面",
        "en": "Recovered wall",
        "fr": "Mur récupéré"
      },
      "caption": {
        "ja": "SH-KB-02 · 映像を見ながら歩いて調査",
        "en": "SH-KB-02 · Observe as you walk",
        "fr": "SH-KB-02 · Observez en marchant"
      },
      "cues": {
        "ja": [
          {
            "text": "こちらが調査対象の壁です。",
            "durationMs": 2400
          },
          {
            "text": "調査には、怪異を映像で捉える観測装置を使います。",
            "durationMs": 3600
          },
          {
            "text": "装置を通じてエージェントが案内しますので、その指示に従って歩いてください。",
            "durationMs": 5500
          },
          {
            "text": "映像はあなたの位置に応じて自動で切り替わります。",
            "durationMs": 3500
          }
        ],
        "en": [
          {
            "text": "This is the wall you will investigate.",
            "durationMs": 2700
          },
          {
            "text": "You will use an observation device that reveals anomalies in its images.",
            "durationMs": 4500
          },
          {
            "text": "An agent will guide you through the device, so follow its directions as you walk.",
            "durationMs": 5500
          },
          {
            "text": "The view changes automatically as you move.",
            "durationMs": 3000
          }
        ],
        "fr": [
          {
            "text": "Voici le mur que vous allez examiner.",
            "durationMs": 2700
          },
          {
            "text": "Vous utiliserez un dispositif d’observation qui révèle les anomalies dans les images.",
            "durationMs": 4700
          },
          {
            "text": "Un agent vous guidera à travers le dispositif, alors suivez ses consignes pour avancer.",
            "durationMs": 5600
          },
          {
            "text": "La vue change automatiquement selon votre position.",
            "durationMs": 3500
          }
        ]
      }
    },
    {
      "id": "report",
      "image": "briefing-device-v1.png",
      "alt": {
        "ja": "観測装置と手元のコントローラー",
        "en": "The observation headset and handheld controller",
        "fr": "Le dispositif d’observation et sa manette"
      },
      "eyebrow": {
        "ja": "異変の報告",
        "en": "REPORTING ANOMALIES",
        "fr": "SIGNALER UNE ANOMALIE"
      },
      "title": {
        "ja": "XかYを長押し",
        "en": "Hold X or Y",
        "fr": "Maintenez X ou Y"
      },
      "caption": {
        "ja": "左コントローラー · どちらか一つを1秒間",
        "en": "Left controller · Either button · 1 second",
        "fr": "Manette gauche · Un seul bouton · 1 seconde"
      },
      "cues": {
        "ja": [
          {
            "text": "映像に異変を見つけたら、左コントローラーのXかYを1秒間長押ししてください。",
            "durationMs": 5000
          },
          {
            "text": "この操作で報告が送られ、エージェントが解析します。",
            "durationMs": 3500
          }
        ],
        "en": [
          {
            "text": "If you spot an anomaly in the image, hold X or Y on the left controller for one second.",
            "durationMs": 5600
          },
          {
            "text": "This sends a report for the agent to analyse.",
            "durationMs": 3200
          }
        ],
        "fr": [
          {
            "text": "Si vous repérez une anomalie dans l’image, maintenez X ou Y sur la manette gauche pendant une seconde.",
            "durationMs": 6000
          },
          {
            "text": "Cette action envoie un signalement que l’agent analysera.",
            "durationMs": 3400
          }
        ]
      }
    },
    {
      "id": "wear",
      "image": "doctor.jpg",
      "alt": {
        "ja": "装置の装着を案内する博士",
        "en": "The doctor asks you to put on the device",
        "fr": "Le docteur vous invite à mettre le dispositif"
      },
      "eyebrow": {
        "ja": "説明は以上です",
        "en": "BRIEFING COMPLETE",
        "fr": "FIN DES CONSIGNES"
      },
      "title": {
        "ja": "装着案内",
        "en": "Putting on the device",
        "fr": "Mise en place du dispositif"
      },
      "caption": {
        "ja": "装着後はエージェントが案内します",
        "en": "The agent will guide you once you are equipped",
        "fr": "L’agent vous guidera une fois équipé"
      },
      "cues": {
        "ja": [
          {
            "text": "では、コントローラーを左手に持ち、装置を装着してください。",
            "durationMs": 4000
          }
        ],
        "en": [
          {
            "text": "Now hold the controller in your left hand and put on the device.",
            "durationMs": 4200
          }
        ],
        "fr": [
          {
            "text": "À présent, prenez la manette dans la main gauche et mettez le dispositif.",
            "durationMs": 4200
          }
        ]
      }
    }
  ]
}
