{
  "schemaVersion": 1,
  "scenes": [
    {
      "id": "introduction",
      "layout": "doctor-center",
      "image": "doctor.jpg",
      "doctorImage": "doctor.jpg",
      "doctorAnchor": 70,
      "alt": {
        "ja": "黒い背景の前にいる白衣の博士",
        "en": "The doctor in a lab coat against a dark background",
        "fr": "Le docteur en blouse devant un fond sombre"
      },
      "eyebrow": {
        "ja": "観測調査",
        "en": "OBSERVATION SURVEY",
        "fr": "MISSION D’OBSERVATION"
      },
      "title": {
        "ja": "調査依頼",
        "en": "Survey briefing",
        "fr": "Présentation de la mission"
      },
      "caption": {
        "ja": "博士 · 怪異調査統括",
        "en": "Doctor · Anomalous investigations",
        "fr": "Docteur · Supervision des enquêtes"
      },
      "cues": {
        "ja": [
          {
            "text": "はじめまして。日本怪異研究所へようこそ。私はあなたの上司にあたる、博士です。",
            "durationMs": 7582
          },
          {
            "text": "あなたに、ある呪われたオブジェクトの調査を依頼します。",
            "durationMs": 4688
          }
        ],
        "en": [
          {
            "text": "Nice to meet you. Welcome to the Japan Institute of Anomalies. I am the doctor, your supervisor.",
            "durationMs": 6500
          },
          {
            "text": "I would like you to serve as an investigator and examine a cursed object.",
            "durationMs": 4800
          }
        ],
        "fr": [
          {
            "text": "Enchanté. Bienvenue à l'Institut japonais de recherche sur les phénomènes étranges. Je suis le docteur, votre supérieur.",
            "durationMs": 7500
          },
          {
            "text": "Je vous demande d’examiner, en tant qu’agent de terrain, un objet maudit.",
            "durationMs": 5200
          }
        ]
      }
    },
    {
      "id": "subject",
      "layout": "doctor-evidence",
      "image": "camera-01-doll.webp",
      "doctorImage": "doctor.jpg",
      "doctorAnchor": 70,
      "alt": {
        "ja": "実際の撮影場所にある幕と手すりを人形視点で加工した写真",
        "en": "The actual filming location, with curtains and a handrail, processed as the doll's camera view",
        "fr": "Le lieu de tournage réel, avec rideaux et main courante, traité comme la vue de la caméra de la poupée"
      },
      "eyebrow": {
        "ja": "調査方法",
        "en": "SURVEY PROCEDURE",
        "fr": "DÉROULEMENT"
      },
      "title": {
        "ja": "探索方法",
        "en": "How to explore",
        "fr": "Méthode d'exploration"
      },
      "caption": {
        "ja": "SH-KB-02 · 映像を見ながら歩いて調査",
        "en": "SH-KB-02 · Observe as you walk",
        "fr": "SH-KB-02 · Observez en marchant"
      },
      "loopVideo": {
        "file": "kabe-one-lap-doll-v1.mp4",
        "startCue": 1
      },
      "cues": {
        "ja": [
          {
            "text": "こちらのカーテンです。",
            "durationMs": 3065
          },
          {
            "text": "観測装置をつけ、このカーテンを3周してください。",
            "durationMs": 3927
          },
          {
            "text": "その間は右手で手すりを持ち、離さないでください。",
            "durationMs": 4368
          },
          {
            "text": "異変を見逃さないよう、ゆっくり慎重に歩いてください。",
            "durationMs": 4695
          }
        ],
        "en": [
          {
            "text": "This is the curtain you will investigate.",
            "durationMs": 2700
          },
          {
            "text": "Put on the observation device and walk around this curtain three times.",
            "durationMs": 5000
          },
          {
            "text": "Hold the handrail with your right hand and keep hold of it as you walk.",
            "durationMs": 5000
          },
          {
            "text": "Your footing will be hard to see, so walk very slowly and carefully.",
            "durationMs": 5000
          }
        ],
        "fr": [
          {
            "text": "Voici le rideau que vous allez examiner.",
            "durationMs": 2700
          },
          {
            "text": "Mettez le dispositif d'observation et faites trois fois le tour de ce rideau.",
            "durationMs": 5500
          },
          {
            "text": "Tenez la main courante de la main droite et ne la lâchez pas en marchant.",
            "durationMs": 5500
          },
          {
            "text": "Vous distinguerez mal le sol à vos pieds : avancez très lentement et avec prudence.",
            "durationMs": 5500
          }
        ]
      }
    },
    {
      "id": "report",
      "layout": "doctor-evidence",
      "image": "briefing-device-v1.png",
      "doctorImage": "doctor.jpg",
      "doctorAnchor": 70,
      "alt": {
        "ja": "観測装置と手元のコントローラー",
        "en": "The observation headset and handheld controller",
        "fr": "Le dispositif d’observation et sa manette"
      },
      "eyebrow": {
        "ja": "異変の報告",
        "en": "REPORTING ANOMALIES",
        "fr": "SIGNALER UNE ANOMALIE"
      },
      "title": {
        "ja": "XかYを長押し",
        "en": "Hold X or Y",
        "fr": "Maintenez X ou Y"
      },
      "caption": {
        "ja": "左コントローラー · 1秒間",
        "en": "Left controller · Either button · 1 second",
        "fr": "Manette gauche · Un seul bouton · 1 seconde"
      },
      "audio": {
        "ja": "report-ja-v1.mp3"
      },
      "cues": {
        "ja": [
          {
            "text": "これが、怪異を記録・解析する観測装置です。",
            "durationMs": 4489
          },
          {
            "text": "あなたの調査を支援するエージェントが搭載されています。",
            "durationMs": 4362
          },
          {
            "text": "異変に気づいたら、左コントローラーのXかYを1秒、長押ししてください。",
            "durationMs": 6864
          },
          {
            "text": "エージェントが解析してくれます。",
            "durationMs": 2576
          }
        ],
        "en": [
          {
            "text": "You will use an observation device that records and analyses anomalies.",
            "durationMs": 4500
          },
          {
            "text": "While you are observing, an agent will support your investigation.",
            "durationMs": 4200
          },
          {
            "text": "If you spot an anomaly, hold X or Y on the left controller for one second.",
            "durationMs": 5600
          },
          {
            "text": "The report will be sent to the agent for analysis.",
            "durationMs": 3200
          }
        ],
        "fr": [
          {
            "text": "Vous utiliserez un dispositif d’observation qui enregistre et analyse les phénomènes anormaux.",
            "durationMs": 4700
          },
          {
            "text": "Pendant l’observation, un agent vous assistera dans votre enquête.",
            "durationMs": 4300
          },
          {
            "text": "Si vous repérez une anomalie, maintenez X ou Y sur la manette gauche pendant une seconde.",
            "durationMs": 6000
          },
          {
            "text": "Le signalement sera envoyé à l’agent pour analyse.",
            "durationMs": 3400
          }
        ]
      }
    },
    {
      "id": "wear",
      "layout": "doctor-center",
      "image": "doctor.jpg",
      "doctorImage": "doctor.jpg",
      "doctorAnchor": 70,
      "alt": {
        "ja": "装置の装着を案内する博士",
        "en": "The doctor asks you to put on the device",
        "fr": "Le docteur vous invite à mettre le dispositif"
      },
      "eyebrow": {
        "ja": "説明は以上です",
        "en": "BRIEFING COMPLETE",
        "fr": "FIN DES CONSIGNES"
      },
      "title": {
        "ja": "装着案内",
        "en": "Putting on the device",
        "fr": "Mise en place du dispositif"
      },
      "caption": {
        "ja": "装着後はエージェントが案内します",
        "en": "The agent will guide you once you are equipped",
        "fr": "L’agent vous guidera une fois équipé"
      },
      "audio": {
        "ja": "wear-ja-v1.mp3"
      },
      "cues": {
        "ja": [
          {
            "text": "では、左手にコントローラーを持って観測装置をつけてください。",
            "durationMs": 5567
          },
          {
            "text": "健闘を祈ります。",
            "durationMs": 1942
          }
        ],
        "en": [
          {
            "text": "Now hold the controller in your left hand and put on the device.",
            "durationMs": 4200
          },
          {
            "text": "Good luck with your survey.",
            "durationMs": 3000
          }
        ],
        "fr": [
          {
            "text": "À présent, prenez la manette dans la main gauche et mettez le dispositif.",
            "durationMs": 4200
          },
          {
            "text": "Bonne chance pour votre enquête.",
            "durationMs": 3000
          }
        ]
      }
    }
  ]
}
