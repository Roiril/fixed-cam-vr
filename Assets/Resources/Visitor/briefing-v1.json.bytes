{
  "schemaVersion": 1,
  "scenes": [
    {
      "id": "introduction",
      "layout": "doctor-center",
      "image": "doctor.jpg",
      "doctorImage": "doctor.jpg",
      "doctorAnchor": 70,
      "alt": {
        "ja": "黒い背景の前にいる白衣の博士",
        "en": "The doctor in a lab coat against a dark background",
        "fr": "Le docteur en blouse devant un fond sombre"
      },
      "eyebrow": {
        "ja": "観測調査",
        "en": "OBSERVATION SURVEY",
        "fr": "MISSION D’OBSERVATION"
      },
      "title": {
        "ja": "調査依頼",
        "en": "Survey briefing",
        "fr": "Présentation de la mission"
      },
      "caption": {
        "ja": "博士 · 観測調査担当",
        "en": "Doctor · Observation research",
        "fr": "Docteur · Recherche sur les phénomènes"
      },
      "cues": {
        "ja": [
          {
            "text": "私はこの研究所で怪異の観測を担当しています。",
            "durationMs": 3500
          },
          {
            "text": "あなたには調査員として、呪われたオブジェクトを調べていただきたい。",
            "durationMs": 4600
          }
        ],
        "en": [
          {
            "text": "I study anomalous phenomena here at the institute.",
            "durationMs": 3400
          },
          {
            "text": "I would like you to serve as an investigator and examine a cursed object.",
            "durationMs": 4800
          }
        ],
        "fr": [
          {
            "text": "J’étudie les phénomènes anormaux dans cet institut.",
            "durationMs": 3500
          },
          {
            "text": "Je vous demande d’examiner, en tant qu’agent de terrain, un objet maudit.",
            "durationMs": 5200
          }
        ]
      }
    },
    {
      "id": "subject",
      "layout": "doctor-evidence",
      "image": "briefing-wall-v1.png",
      "doctorImage": "doctor.jpg",
      "doctorAnchor": 70,
      "alt": {
        "ja": "暗い調査室に保管されたL字の壁面",
        "en": "A recovered L-shaped wall held in a dark examination room",
        "fr": "Un mur récupéré en forme de L dans une salle d’examen sombre"
      },
      "eyebrow": {
        "ja": "調査方法",
        "en": "SURVEY PROCEDURE",
        "fr": "DÉROULEMENT"
      },
      "title": {
        "ja": "回収壁面",
        "en": "Recovered wall",
        "fr": "Mur récupéré"
      },
      "caption": {
        "ja": "SH-KB-02 · 映像を見ながら歩いて調査",
        "en": "SH-KB-02 · Observe as you walk",
        "fr": "SH-KB-02 · Observez en marchant"
      },
      "cues": {
        "ja": [
          {
            "text": "こちらが調査対象の壁です。",
            "durationMs": 2400
          },
          {
            "text": "調査には怪異の記録と解析を行う観測装置を使います。",
            "durationMs": 3600
          },
          {
            "text": "装着後はエージェントの案内に従って調査を進めてください。",
            "durationMs": 5500
          },
          {
            "text": "動画のように3周します。",
            "durationMs": 3000
          },
          {
            "text": "右手で手すりを持ち、手を離さずに進んでください。",
            "durationMs": 4200
          },
          {
            "text": "足元が見づらいので、ゆっくりゆっくり、慎重に歩いてください。",
            "durationMs": 5200
          }
        ],
        "en": [
          {
            "text": "This is the wall you will investigate.",
            "durationMs": 2700
          },
          {
            "text": "You will use an observation device that records and analyses anomalies.",
            "durationMs": 4500
          },
          {
            "text": "Once you put on the device, an agent will guide you along the survey route, so follow its directions.",
            "durationMs": 5500
          },
          {
            "text": "Walk around it three times as shown in the video.",
            "durationMs": 3800
          },
          {
            "text": "Hold the handrail with your right hand and keep hold of it as you walk.",
            "durationMs": 5000
          },
          {
            "text": "Your footing will be hard to see, so walk very slowly and carefully.",
            "durationMs": 5000
          }
        ],
        "fr": [
          {
            "text": "Voici le mur que vous allez examiner.",
            "durationMs": 2700
          },
          {
            "text": "Vous utiliserez un dispositif d’observation qui enregistre et analyse les phénomènes anormaux.",
            "durationMs": 4700
          },
          {
            "text": "Une fois le dispositif en place, un agent vous guidera sur le parcours d’enquête ; suivez ses consignes.",
            "durationMs": 5600
          },
          {
            "text": "Faites-en trois fois le tour, comme dans la vidéo.",
            "durationMs": 4200
          },
          {
            "text": "Tenez la main courante de la main droite et ne la lâchez pas en marchant.",
            "durationMs": 5500
          },
          {
            "text": "Vous distinguerez mal le sol à vos pieds : avancez très lentement et avec prudence.",
            "durationMs": 5500
          }
        ]
      }
    },
    {
      "id": "report",
      "layout": "doctor-evidence",
      "image": "briefing-device-v1.png",
      "doctorImage": "doctor.jpg",
      "doctorAnchor": 70,
      "alt": {
        "ja": "観測装置と手元のコントローラー",
        "en": "The observation headset and handheld controller",
        "fr": "Le dispositif d’observation et sa manette"
      },
      "eyebrow": {
        "ja": "異変の報告",
        "en": "REPORTING ANOMALIES",
        "fr": "SIGNALER UNE ANOMALIE"
      },
      "title": {
        "ja": "XかYを長押し",
        "en": "Hold X or Y",
        "fr": "Maintenez X ou Y"
      },
      "caption": {
        "ja": "左コントローラー · どちらか一つを1秒間",
        "en": "Left controller · Either button · 1 second",
        "fr": "Manette gauche · Un seul bouton · 1 seconde"
      },
      "cues": {
        "ja": [
          {
            "text": "異変を見つけたら、左コントローラーのXかYを1秒間長押ししてください。",
            "durationMs": 5000
          },
          {
            "text": "報告はエージェントへ送られ、その内容が解析されます。",
            "durationMs": 3500
          }
        ],
        "en": [
          {
            "text": "If you spot an anomaly, hold X or Y on the left controller for one second.",
            "durationMs": 5600
          },
          {
            "text": "The report will be sent to the agent for analysis.",
            "durationMs": 3200
          }
        ],
        "fr": [
          {
            "text": "Si vous repérez une anomalie, maintenez X ou Y sur la manette gauche pendant une seconde.",
            "durationMs": 6000
          },
          {
            "text": "Le signalement sera envoyé à l’agent pour analyse.",
            "durationMs": 3400
          }
        ]
      }
    },
    {
      "id": "wear",
      "layout": "doctor-center",
      "image": "doctor.jpg",
      "doctorImage": "doctor.jpg",
      "doctorAnchor": 70,
      "alt": {
        "ja": "装置の装着を案内する博士",
        "en": "The doctor asks you to put on the device",
        "fr": "Le docteur vous invite à mettre le dispositif"
      },
      "eyebrow": {
        "ja": "説明は以上です",
        "en": "BRIEFING COMPLETE",
        "fr": "FIN DES CONSIGNES"
      },
      "title": {
        "ja": "装着案内",
        "en": "Putting on the device",
        "fr": "Mise en place du dispositif"
      },
      "caption": {
        "ja": "装着後はエージェントが案内します",
        "en": "The agent will guide you once you are equipped",
        "fr": "L’agent vous guidera une fois équipé"
      },
      "cues": {
        "ja": [
          {
            "text": "コントローラーを左手に持ち、観測装置を装着してください。",
            "durationMs": 4000
          },
          {
            "text": "健闘を祈ります。",
            "durationMs": 3000
          }
        ],
        "en": [
          {
            "text": "Now hold the controller in your left hand and put on the device.",
            "durationMs": 4200
          },
          {
            "text": "Good luck with your survey.",
            "durationMs": 3000
          }
        ],
        "fr": [
          {
            "text": "À présent, prenez la manette dans la main gauche et mettez le dispositif.",
            "durationMs": 4200
          },
          {
            "text": "Bonne chance pour votre enquête.",
            "durationMs": 3000
          }
        ]
      }
    }
  ]
}
